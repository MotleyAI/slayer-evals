{
 "tool": "query",
 "args": {
  "query": {
   "source_model": "orders",
   "time_dimensions": [
    {
     "dimension": "order_date",
     "granularity": "month"
    }
   ],
   "measures": [
    {
     "formula": "sum(amount)",
     "name": "rev"
    },
    {
     "formula": "cumsum(sum(amount))",
     "name": "running"
    }
   ],
   "filters": [
    "order_date >= '2025-01-01'"
   ]
  },
  "format": "json"
 },
