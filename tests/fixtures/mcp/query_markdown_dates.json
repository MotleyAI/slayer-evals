{
 "tool": "query",
 "args": {
  "query": {
   "source_model": "orders",
   "time_dimensions": [
    {
     "dimension": "order_date",
     "granularity": "month"
    }
   ],
   "measures": [
    {
     "formula": "sum(amount)",
     "name": "rev"
    },
    {
     "formula": "cumsum(sum(amount))",
     "name": "running"
    }
   ],
   "filters": [
    "order_date >= '2025-01-01'"
   ]
  }
 },
 "is_error": false,
 "text": "| orders.order_date | orders.rev | orders.running |\n| --- | --- | --- |\n| 2025-01-01 00:00:00 | 140.0 | 140 |\n| 2025-02-01 00:00:00 | 200.0 | 340 |\n| 2025-03-01 00:00:00 | 140.0 | 480 |\n| 2025-05-01 00:00:00 | 225.0 | 705 |\n| 2025-06-01 00:00:00 | 210.0 | 915 |\n\nMeasure attributes:\n  orders.running: format=(type=float)"
}
