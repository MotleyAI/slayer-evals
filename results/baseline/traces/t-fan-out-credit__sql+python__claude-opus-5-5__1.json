    "sql": "select (select count(*) from orders where customer_id is null) null_cust,\n(select count(*) from orders o where customer_id is not null and not exists(select 1 from customers c where c.id=o.customer_id)) orphan,\n(select count(*) from customers where region_id is null) null_reg,\n(select count(*) from customers c where region_id is not null and not exists(select 1 from regions r where r.id=c.region_id)) orphan_reg,\n(select count(*)-count(distinct id) from customers) dup_c,\n(select count(*)-count(distinct id) from regions) dup_r,\n(select count(*) from regions where name is null) nullname"
