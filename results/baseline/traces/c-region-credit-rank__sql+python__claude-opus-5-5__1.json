   "args": {
    "sql": "with rev as (select c.region_id, sum(o.amount) revenue from orders o join customers c on c.id=o.customer_id group by 1),\ncr as (select region_id, sum(credit) credit from customers group by 1)\nselect r.name region, rev.revenue, rank() over (order by rev.revenue desc nulls last) rnk, cr.credit, (select count(*)-count(distinct id) from customers) dup\nfrom regions r left join rev on rev.region_id=r.id left join cr on cr.region_id=r.id order by rnk"
   },
