    "sql": "with rev as (select c.region_id, sum(o.amount) revenue from orders o join customers c on c.id=o.customer_id where c.region_id is not null group by 1),\ncr as (select region_id, sum(credit) credit from customers where region_id is not null group by 1)\nselect r.name region, rev.revenue, rank() over (order by rev.revenue desc nulls last) rnk, cr.credit\nfrom regions r left join rev on rev.region_id=r.id left join cr on cr.region_id=r.id order by rnk"
