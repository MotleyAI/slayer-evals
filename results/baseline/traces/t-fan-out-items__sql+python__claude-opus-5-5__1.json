    "sql": "with o as (select o.id, o.amount, r.name region from orders o left join customers c on c.id=o.customer_id left join regions r on r.id=c.region_id),\nrev as (select region, sum(amount) revenue, count(*) n_orders from o group by region),\nli as (select o.region, count(oi.id) lines from order_items oi join o on o.id=oi.order_id group by o.region)\nselect rev.region, revenue, coalesce(lines,0) lines, n_orders from rev left join li on li.region is not distinct from rev.region order by 1"
