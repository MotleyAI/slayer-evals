   "args": {
    "sql": "with o as (select o.id, o.amount, r.name region from orders o left join customers c on c.id=o.customer_id left join regions r on r.id=c.region_id),\nli as (select order_id, count(*) n from order_items group by 1)\nselect region, sum(amount) revenue, coalesce(sum(n),0) order_lines, count(*) orders from o left join li on li.order_id=o.id group by 1 order by 1"
   },
