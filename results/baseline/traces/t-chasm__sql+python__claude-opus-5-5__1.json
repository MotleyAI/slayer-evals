    "sql": "with o as (select r.name region, sum(o.amount) amt from orders o left join customers c on c.id=o.customer_id left join regions r on r.id=c.region_id group by 1),\nrt as (select r.name region, sum(x.amount) amt from returns x left join customers c on c.id=x.customer_id left join regions r on r.id=c.region_id group by 1),\ng as (select distinct r.name region from customers c left join regions r on r.id=c.region_id union select region from o union select region from rt)\nselect g.region, o.amt total_ordered, rt.amt total_returned from g left join o on o.region is not distinct from g.region left join rt on rt.region is not distinct from g.region order by 1 nulls last"
