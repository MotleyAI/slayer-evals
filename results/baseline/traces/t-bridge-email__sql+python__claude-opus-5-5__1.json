    "sql": "select r.name region, sum(o.amount) revenue, count(*) n\nfrom orders o join customers c on c.id=o.customer_id left join regions r on r.id=c.region_id\nwhere o.customer_id in (select cm.customer_id from campaign_members cm join campaigns ca on ca.id=cm.campaign_id where ca.channel='email')\ngroup by 1 order by 1"
