    "sql": "with t as (select distinct user_id from tweets where year(tweeted_at)=2025),\no as (select * from orders where year(ordered_at)=2025)\nselect case when t.user_id is not null then 'tweeted' else 'did not tweet' end seg,\ncount(distinct o.customer) customers, count(*) orders, sum(subtotal)/100.0/count(*) aov\nfrom o left join t on o.customer=t.user_id group by 1"
