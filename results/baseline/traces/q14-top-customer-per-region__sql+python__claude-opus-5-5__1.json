    "sql": "with r as (select c.region_id, rg.name, o.customer_id, sum(o.amount) rev from orders o join customers c on c.id=o.customer_id left join regions rg on rg.id=c.region_id where c.region_id is not null group by all),\nk as (select *, rank() over (partition by region_id order by rev desc nulls last) rk from r)\nselect *, (select count(*) from customers) n, (select count(distinct id) from customers) nd from k where rk=1 order by region_id"
