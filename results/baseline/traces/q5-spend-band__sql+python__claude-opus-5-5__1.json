    "sql": "with c as (select customer_id, sum(amount) t from orders where customer_id is not null group by 1)\nselect case when c.t>2000 then 'high' else 'other' end grp, sum(o.amount) revenue, count(*) n, count(o.amount) na\nfrom orders o left join c using(customer_id) group by 1"
