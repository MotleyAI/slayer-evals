   "tool": "sql",
   "args": {
    "sql": "with b as (select date_trunc('month', o.order_date)::date m, r.name region, sum(o.amount) rev\n from orders o left join customers c on c.id=o.customer_id left join regions r on r.id=c.region_id\n where o.order_date >= '2024-12-01' and o.order_date < '2025-04-01' group by all),\n g as (select m, region from (select distinct m from b) cross join (select distinct region from b)),\n f as (select g.m, g.region, b.rev from g left join b using (m, region))\nselect m as month, region, rev as revenue, rev / sum(rev) over (partition by m) as share,\n rev - lag(coalesce(rev,0)) over (partition by region order by m) as change\nfrom f qualify m >= '2025-01-01' order by m, region nulls last"
