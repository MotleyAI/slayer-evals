    "sql": "with rev as (select r.name region, sum(o.amount) revenue from orders o left join customers c on o.customer_id=c.id left join regions r on c.region_id=r.id group by 1),\ncr as (select r.name region, sum(c.credit) credit from customers c left join regions r on c.region_id=r.id group by 1),\nkeys as (select region from rev union select region from cr union select name from regions)\nselect k.region, rev.revenue, cr.credit from keys k left join rev on rev.region is not distinct from k.region left join cr on cr.region is not distinct from k.region order by 1 nulls last"
