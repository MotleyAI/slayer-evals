    "sql": "with rev as (select r.name region, sum(o.amount) revenue from orders o left join customers c on c.id=o.customer_id left join regions r on r.id=c.region_id group by 1),\ncr as (select r.name region, sum(c.credit) credit from customers c left join regions r on r.id=c.region_id group by 1)\nselect coalesce(rev.region, cr.region) region, revenue, credit from rev full join cr on rev.region is not distinct from cr.region order by 1 nulls last"
   },
